# Managed by Ansible (role vantage_tunnel). Changes are overwritten.
# Fixed configuration: validate the Vantage token on every request and forward
# to slurmrestd on this node (the proxy's default upstream, 127.0.0.1:6820).
VANTAGE_AUTHPROXY_CLUSTER="{{ vantage_tunnel_cluster_name | replace('\\', '\\\\') | replace('"', '\\"') }}"
VANTAGE_AUTHPROXY_ISSUER="{{ vantage_tunnel_oidc_base_url | trim('/') }}{{ vantage_tunnel_realm_path }}"
VANTAGE_AUTHPROXY_AUDIENCE="{{ vantage_tunnel_client_id | replace('\\', '\\\\') | replace('"', '\\"') }}"
VANTAGE_AUTHPROXY_LISTEN="{{ vantage_tunnel_proxy_listen_host }}:{{ vantage_tunnel_proxy_listen_port }}"
